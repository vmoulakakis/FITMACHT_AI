# Public read-only SocialMarket consumer. This is OPTIONAL until owner validates RLS/grants.
SOCIALMARKET_SUPABASE_URL=
SOCIALMARKET_SUPABASE_PUBLISHABLE_KEY=
# HARD SECURITY GATE: supply exact allowlisted Linkwise tracking hosts.
FITMATCH_LINKWISE_HOSTS=
# Optional isolated FITMATCH records, never share SocialMarket service-role tokens with browser.
FITMATCH_ADMIN_SYNC_KEY=

# Optional Linkwise CD104 import. Paste the exact user-authorized JSON feed URL
# in local/private deployment secrets. Never expose the URL in NEXT_PUBLIC_ vars.
LINKWISE_FITMATCH_FEED_URL=
# Staging-only product candidates; do NOT expose raw feed or tracking URLs.
FITMATCH_LINKWISE_AUDIT_PATH=.fitmatch-private/linkwise-cd104-candidates.jsonl
FITMATCH_MAX_AUDIT_CANDIDATES=10000
